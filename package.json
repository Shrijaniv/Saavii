{
  "name": "saavii",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "db:generate": "prisma generate --schema packages/store/schema.prisma",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "depcruise apps packages workers --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run check:boundaries && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "dependency-cruiser": "^16.0.0",
    "tsx": "^4.23.8",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
